# Copiez ce fichier en server/.env (ou définissez ces variables chez l'hébergeur).

# Base PostgreSQL (locale ou Neon). Exemple Neon :
# DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/materna?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/materna

# Secret de signature des sessions : une longue chaîne aléatoire
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

PORT=3000
NODE_ENV=development
# Réinitialisation de la démo et changement rapide de profil (désactivez en usage réel)
DEMO_MODE=true

# ---- SMS de vérification ----
# twilio | orange | demo (demo = aucun SMS envoyé, le code s'affiche à l'écran)
SMS_FOURNISSEUR=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=   (à la place de TWILIO_FROM si vous utilisez un service de messagerie)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER=tel:+2210000

# Facultatif : votre vrai numéro (format +221...). Il remplace celui du dossier de démonstration de
# Mariama Sow au chargement des données, pour recevoir le SMS pendant une démonstration.
TELEPHONE_DEMO=
